    {
      "id": "control:templates/_navbar.html:select:export-jpg-scale:10",
      "setup": [],
      "request_or_gesture": {
        "page": "/sorting/visualizador",
        "viewport": {
          "width": 1366,
          "height": 1000
        },
        "gesture": {
          "action": "select_option",
          "selector": "#export-jpg-scale",
          "value": "2"
        },
        "setup_input": [
          7,
          2,
          9
        ],
        "followup_gesture": {
          "action": "click",
          "selector": "#export-visual-jpg-btn"
        },
        "reference_export": {
          "select_scale": "1",
          "download_decode": [
            "W1",
            "H1"
          ]
        },
        "owned_server": "New private-session Flask fixture; no existing externalURL, hostpermissions or user5051."
      },
      "expected": {
        "selected_value": "2",
        "download_mime": "image/jpeg",
        "nonuniform_RGB": true,
        "export_POST_count": 0,
        "dimension_oracle": {
          "decode_scale1_export": [
            "W1",
            "H1"
          ],
          "decode_scale2_export": [
            "2*W1",
            "2*H1"
          ],
          "precondition": "Same target, unchanged source dimensions; export scale1 once then scale2; current resolveExportDimensions rounds source dimensions before scaling.",
          "no_historical_geometry_transplant": true
        }
      },
      "expected_status": null
    },
