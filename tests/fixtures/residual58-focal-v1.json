{
  "schema": "residual58-focal/v1",
  "cases": [
    {
      "id": "algorithm:graph/camino-minimo/run_bellman_ford",
      "setup": [
        {
          "method": "GET",
          "path": "/graph/graph/camino-minimo",
          "expected_status": 200,
          "expected_content": "camino-minimo"
        },
        {
          "operation": "create_graph",
          "payload": {
            "directed": false
          }
        },
        {
          "operation": "insert_vertex",
          "payload": {
            "vertex": 1
          }
        },
        {
          "operation": "insert_vertex",
          "payload": {
            "vertex": 2
          }
        },
        {
          "operation": "insert_vertex",
          "payload": {
            "vertex": 3
          }
        },
        {
          "operation": "insert_edge",
          "payload": {
            "origin": 1,
            "target": 2,
            "weight": 1
          }
        },
        {
          "operation": "insert_edge",
          "payload": {
            "origin": 2,
            "target": 3,
            "weight": 2
          }
        }
      ],
      "request_or_gesture": {
        "method": "POST",
        "path": "/graph/graph/operate",
        "json": {
          "operation": "run_bellman_ford",
          "payload": {
            "start": 1,
            "end": 3
          }
        }
      },
      "expected": {
        "result.path": [
          1,
          2,
          3
        ],
        "result.distance_to_destination": 3
      },
      "expected_status": 200
    },
