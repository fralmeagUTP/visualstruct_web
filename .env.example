# Copy this file to .env and replace the value before starting Docker.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Local Docker access uses HTTP. In an HTTPS deployment, use false for the
# override and true for SESSION_COOKIE_SECURE.
SESSION_COOKIE_SECURE=false
ALLOW_INSECURE_COOKIES_IN_PRODUCTION=true

# Optional host port; the container always listens on 5050.
VISUALSTRUCT_PORT=5050
